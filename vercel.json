{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "bun install",
	"buildCommand": "bun run build",
	"schedules": {
		"battles": {
			"schedule": "0 * * * *",
			"path": "/api/cron/battles",
			"requestMethod": "GET"
		},
		"bloc-elections": {
			"schedule": "0 0 * * *",
			"path": "/api/cron/bloc-elections",
			"requestMethod": "GET"
		},
		"elections": {
			"schedule": "0 * * * *",
			"path": "/api/cron/elections",
			"requestMethod": "GET"
		},
		"premium": {
			"schedule": "*/15 * * * *",
			"path": "/api/cron/premium",
			"requestMethod": "GET"
		},
		"proposals": {
			"schedule": "*/15 * * * *",
			"path": "/api/cron/proposals",
			"requestMethod": "GET"
		},
		"travels": {
			"schedule": "*/15 * * * *",
			"path": "/api/cron/travels",
			"requestMethod": "GET"
		},
		"fleet": {
			"schedule": "*/15 * * * *",
			"path": "/api/cron/fleet",
			"requestMethod": "GET"
		},
		"wars": {
			"schedule": "0 * * * *",
			"path": "/api/cron/wars",
			"requestMethod": "GET"
		},
		"world-snapshot": {
			"schedule": "0 0 * * *",
			"path": "/api/cron/world-snapshot",
			"requestMethod": "GET"
		},
		"earnings": {
			"schedule": "0 0 * * 1",
			"path": "/api/cron/earnings",
			"requestMethod": "GET"
		},
		"population": {
			"schedule": "0 1 * * 1",
			"path": "/api/cron/population",
			"requestMethod": "GET"
		},
		"workforce": {
			"schedule": "0 2 * * 1",
			"path": "/api/cron/workforce",
			"requestMethod": "GET"
		},
		"trade": {
			"schedule": "0 */6 * * *",
			"path": "/api/cron/trade",
			"requestMethod": "GET"
		},
		"energy": {
			"schedule": "0 3 * * *",
			"path": "/api/cron/energy",
			"requestMethod": "GET"
		}
	}
}
