# Telegram Bot API token from @BotFather. Must be the SAME token psyops-sv
# uses (TELEGRAM_BOT_TOKEN there) for the /login button to work, since
# Telegram checks the bot's configured domain (BotFather /setdomain).
TELEGRAM=<DEIN_BOT_TOKEN>

# Same Postgres database as psyops-sv (see that repo's DATABASE_URL); this bot
# reads/writes the account and user_profiles tables directly.
GAME_DATABASE_URL=postgresql://user:password@host:5432/psyops
# Set to true if the connection string above doesn't already include
# ?sslmode=require and the database needs SSL (e.g. Neon, Supabase).
GAME_DB_SSL=false

# Public base URL of the psyops-sv deployment, used to build the /login button.
APP_URL=https://psyops-sv.example.com

# While true (default), /premium grants membership for free instead of
# charging real Telegram Stars. Set to false once ready to charge for real.
MOCK_STARS_PAYMENTS=true

# Optional: enable TON crypto payments for /premium in addition to Stars.
# Leave TON_WALLET_ADDRESS empty to only offer Telegram Stars.
TON_WALLET_ADDRESS=
TONCENTER_API_URL=https://toncenter.com/api/v3
TON_API_KEY=

# Optional: post unhandled exceptions to a Telegram group/topic.
LOG_GROUP_ID=0
THREAD_ID=0

CONTAINER=false
