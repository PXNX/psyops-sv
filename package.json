{
	"name": "psyops-sv",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.1",
	"engines": {
		"bun": ">=1.4.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun x vite dev --host",
		"dev:mock": "USE_MOCK=true bun x vite dev --host",
		"build": "bun x vite build",
		"preview": "bun x vite preview",
		"check": "bun x svelte-kit sync && bun x svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun x svelte-kit sync && bun x svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "bun x prettier --check .",
		"format": "bun x prettier --write .",
		"i18n": "typesafe-i18n",
		"test": "bun x rstest",
		"test:watch": "bun x rstest --watch",
		"mock:server": "cd packages/rest-mock && bun run dev",
		"mock:build": "cd packages/rest-mock && bun run build"
	},
